<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_callcenter_campaign_assignment_list" model="ir.ui.view">
        <field name="name">callcenter.campaign.assignment.list</field>
        <field name="model">callcenter.campaign.assignment</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="campaign_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="role"/>
                <field name="is_primary"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active"/>
                <field name="assigned_by_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_callcenter_campaign_assignment_form" model="ir.ui.view">
        <field name="name">callcenter.campaign.assignment.form</field>
        <field name="model">callcenter.campaign.assignment</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="campaign_id"/>
                            <field name="user_id"/>
                            <field name="role"/>
                            <field name="is_primary"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                            <field name="assigned_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_callcenter_campaign_assignment_search" model="ir.ui.view">
        <field name="name">callcenter.campaign.assignment.search</field>
        <field name="model">callcenter.campaign.assignment</field>
        <field name="arch" type="xml">
            <search string="Campaign Assignment History">
                <field name="campaign_id"/>
                <field name="user_id"/>
                <field name="role"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Agents" name="agents" domain="[('role', '=', 'agent')]"/>
                <filter string="Supervisors" name="supervisors" domain="[('role', '=', 'supervisor')]"/>
                <group>
                    <filter string="Campaign" name="group_campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Role" name="group_role" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_callcenter_campaign_assignments" model="ir.actions.act_window">
        <field name="name">Campaign Assignment History</field>
        <field name="res_model">callcenter.campaign.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_callcenter_campaign_assignment_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
