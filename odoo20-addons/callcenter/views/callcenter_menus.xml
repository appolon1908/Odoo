<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_callcenter_campaigns" model="ir.actions.act_window">
        <field name="name">Call Center Campaigns</field>
        <field name="res_model">crm.team</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_callcenter_campaign', '=', True)]</field>
        <field name="context">{'default_is_callcenter_campaign': True}</field>
    </record>

    <record id="action_callcenter_leads" model="ir.actions.act_window">
        <field name="name">Campaign Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="domain">[('team_id.is_callcenter_campaign', '=', True)]</field>
        <field name="context">{'default_type': 'lead'}</field>
    </record>

    <record id="action_callcenter_reporting" model="ir.actions.act_window">
        <field name="name">Call Center Reporting</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="domain">[('team_id.is_callcenter_campaign', '=', True)]</field>
    </record>

    <menuitem id="menu_callcenter_root"
              name="Call Center"
              web_icon="crm,static/description/icon.png"
              sequence="25"
              groups="callcenter.group_callcenter_agent,callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser"/>

    <menuitem id="menu_callcenter_leads"
              name="Campaign Leads"
              parent="menu_callcenter_root"
              action="action_callcenter_leads"
              sequence="5"
              groups="callcenter.group_callcenter_agent,callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser"/>

    <menuitem id="menu_callcenter_campaigns"
              name="Campaigns"
              parent="menu_callcenter_root"
              action="action_callcenter_campaigns"
              sequence="10"
              groups="callcenter.group_callcenter_agent,callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser"/>

    <menuitem id="menu_callcenter_people"
              name="Agents &amp; Supervisors"
              parent="menu_callcenter_root"
              action="action_callcenter_agent_directory"
              sequence="15"
              groups="callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser"/>

    <menuitem id="menu_callcenter_reporting"
              name="Reporting"
              parent="menu_callcenter_root"
              action="action_callcenter_reporting"
              sequence="20"
              groups="callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser"/>

    <menuitem id="menu_callcenter_assignment_history"
              name="Assignment History"
              parent="menu_callcenter_root"
              action="action_callcenter_campaign_assignments"
              sequence="25"
              groups="callcenter.group_callcenter_agent,callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser"/>

    <menuitem id="menu_callcenter_transfer_agent"
              name="Transfer Agent"
              parent="menu_callcenter_root"
              action="action_callcenter_agent_transfer"
              sequence="30"
              groups="callcenter.group_callcenter_superuser"/>
</odoo>
