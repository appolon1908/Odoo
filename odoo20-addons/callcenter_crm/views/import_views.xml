<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_callcenter_import_batch_list" model="ir.ui.view">
        <field name="name">callcenter.lead.import.batch.list</field>
        <field name="model">callcenter.lead.import.batch</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="campaign_id"/>
                <field name="filename"/>
                <field name="file_hash"/>
                <field name="imported_by_id"/>
                <field name="imported_at"/>
                <field name="state"/>
                <field name="total_rows"/>
                <field name="created_count"/>
                <field name="duplicate_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>
    <record id="view_callcenter_import_batch_form" model="ir.ui.view">
        <field name="name">callcenter.lead.import.batch.form</field>
        <field name="model">callcenter.lead.import.batch</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="campaign_id"/>
                        <field name="filename"/>
                        <field name="file_hash"/>
                        <field name="imported_by_id"/>
                        <field name="imported_at"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="total_rows"/>
                        <field name="created_count"/>
                        <field name="duplicate_count"/>
                        <field name="error_count"/>
                    </group>
                    <field name="line_ids">
                        <list create="false" edit="false" delete="false">
                            <field name="row_number"/>
                            <field name="normalized_phone"/>
                            <field name="normalized_email"/>
                            <field name="status"/>
                            <field name="lead_id"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_callcenter_import_history" model="ir.actions.act_window">
        <field name="name">Import History</field>
        <field name="res_model">callcenter.lead.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
