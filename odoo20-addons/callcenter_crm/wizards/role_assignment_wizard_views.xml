<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_callcenter_role_assignment_wizard" model="ir.ui.view">
        <field name="name">callcenter.role.assignment.wizard.form</field>
        <field name="model">callcenter.role.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Call Center Role">
                <group>
                    <field name="user_id"/>
                    <field name="role"/>
                </group>
                <footer>
                    <button name="action_apply" string="Assign Role" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_callcenter_role_assignment_wizard" model="ir.actions.act_window">
        <field name="name">Role Administration</field>
        <field name="res_model">callcenter.role.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
