<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_callcenter_lead_import_wizard" model="ir.ui.view">
        <field name="name">callcenter.lead.import.wizard.form</field>
        <field name="model">callcenter.lead.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Campaign Lead Import">
                <group>
                    <field name="campaign_id"/>
                    <field name="upload_file" filename="filename"/>
                    <field name="filename"/>
                    <field name="allow_duplicate_file"/>
                    <field name="batch_id" invisible="not batch_id"/>
                </group>
                <footer>
                    <button name="action_validate" string="Validate / Preview" type="object" class="btn-secondary"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_callcenter_lead_import_wizard" model="ir.actions.act_window">
        <field name="name">Campaign Lead Import</field>
        <field name="res_model">callcenter.lead.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
