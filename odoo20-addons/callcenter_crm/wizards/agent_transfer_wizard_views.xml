<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_callcenter_agent_transfer_wizard" model="ir.ui.view">
        <field name="name">callcenter.agent.transfer.wizard.form</field>
        <field name="model">callcenter.agent.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Agent">
                <group>
                    <field name="user_id"/>
                    <field name="campaign_id"/>
                    <field name="effective_at"/>
                </group>
                <footer>
                    <button name="action_apply" string="Transfer Agent" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_callcenter_agent_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Agent</field>
        <field name="res_model">callcenter.agent.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
