<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_callcenter" model="ir.module.category">
        <field name="name">Call Center</field>
        <field name="description">Operational call-center CRM permissions.</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_callcenter" model="res.groups.privilege">
        <field name="name">Call Center</field>
        <field name="description">Campaign-scoped operational CRM access.</field>
        <field name="category_id" ref="module_category_callcenter"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_callcenter_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_callcenter"/>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('sales_team.group_sale_salesman'))
        ]"/>
        <field name="comment">Access assigned campaign CRM leads and own campaign history.</field>
    </record>

    <record id="group_callcenter_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_callcenter"/>
        <field name="implied_ids" eval="[Command.link(ref('group_callcenter_agent'))]"/>
        <field name="comment">Read supervised campaigns, their leads, agents, and assignment history.</field>
    </record>

    <record id="group_callcenter_superuser" model="res.groups">
        <field name="name">Call Center Super User</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_callcenter"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_callcenter_supervisor')),
            Command.link(ref('sales_team.group_sale_manager'))
        ]"/>
        <field name="comment">Operational authority across all call-center campaigns without technical system-administrator access.</field>
    </record>
</odoo>
