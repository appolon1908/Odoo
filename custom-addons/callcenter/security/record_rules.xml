<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_callcenter_assignment_agent" model="ir.rule">
        <field name="name">Call Center assignment: agent own history</field>
        <field name="model_id" ref="model_callcenter_campaign_assignment"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_agent'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_callcenter_assignment_supervisor" model="ir.rule">
        <field name="name">Call Center assignment: supervised campaigns</field>
        <field name="model_id" ref="model_callcenter_campaign_assignment"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('campaign_id', 'in', user.callcenter_supervised_campaign_ids.ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_supervisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_callcenter_assignment_superuser" model="ir.rule">
        <field name="name">Call Center assignment: super user all campaigns</field>
        <field name="model_id" ref="model_callcenter_campaign_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_superuser'))]"/>
    </record>

    <record id="rule_callcenter_team_agent" model="ir.rule">
        <field name="name">Call Center teams: agent campaign</field>
        <field name="model_id" ref="sales_team.model_crm_team"/>
        <field name="domain_force">['|', ('is_callcenter_campaign', '=', False), ('id', '=', user.callcenter_primary_campaign_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_agent'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_callcenter_team_supervisor" model="ir.rule">
        <field name="name">Call Center teams: supervised campaigns</field>
        <field name="model_id" ref="sales_team.model_crm_team"/>
        <field name="domain_force">['|', ('is_callcenter_campaign', '=', False), ('id', 'in', user.callcenter_supervised_campaign_ids.ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_supervisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_callcenter_team_superuser" model="ir.rule">
        <field name="name">Call Center teams: super user all teams</field>
        <field name="model_id" ref="sales_team.model_crm_team"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_superuser'))]"/>
    </record>

    <record id="rule_callcenter_lead_agent" model="ir.rule">
        <field name="name">Call Center leads: agent primary campaign</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('team_id', '=', user.callcenter_primary_campaign_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_agent'))]"/>
    </record>

    <record id="rule_callcenter_lead_supervisor" model="ir.rule">
        <field name="name">Call Center leads: supervised campaigns</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('team_id', 'in', user.callcenter_supervised_campaign_ids.ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_supervisor'))]"/>
    </record>

    <record id="rule_callcenter_lead_superuser" model="ir.rule">
        <field name="name">Call Center leads: super user all call-center campaigns</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('team_id.is_callcenter_campaign', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_callcenter_superuser'))]"/>
    </record>
</odoo>
