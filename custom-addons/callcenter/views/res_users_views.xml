<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_callcenter" model="ir.ui.view">
        <field name="name">res.users.form.callcenter</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Call Center"
                      name="callcenter"
                      groups="callcenter.group_callcenter_superuser,base.group_system">
                    <group>
                        <field name="callcenter_primary_campaign_id"/>
                        <field name="callcenter_supervised_campaign_ids"
                               widget="many2many_tags"
                               readonly="1"/>
                    </group>
                    <group string="Campaign Assignment History">
                        <field name="callcenter_assignment_ids" readonly="1">
                            <list create="false" delete="false" edit="false">
                                <field name="campaign_id"/>
                                <field name="role"/>
                                <field name="is_primary"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="active"/>
                                <field name="assigned_by_id"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
