<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_callcenter" model="ir.ui.view">
        <field name="name">res.users.form.callcenter</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Call Center"
                      name="callcenter"
                      groups="callcenter.group_callcenter_superuser,base.group_system">
                    <group>
                        <field name="callcenter_primary_campaign_id" readonly="1"/>
                        <field name="callcenter_supervised_campaign_ids"
                               widget="many2many_tags"
                               readonly="1"/>
                        <field name="callcenter_visible_campaign_ids"
                               widget="many2many_tags"
                               readonly="1"/>
                    </group>
                    <group string="Campaign Assignment History">
                        <field name="callcenter_assignment_ids" readonly="1">
                            <list create="false" delete="false" edit="false">
                                <field name="campaign_id"/>
                                <field name="role"/>
                                <field name="is_primary"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="active"/>
                                <field name="assigned_by_id"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_callcenter_agent_directory_list" model="ir.ui.view">
        <field name="name">res.users.callcenter.directory.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Call Center People"
                  create="false"
                  delete="false"
                  edit="false">
                <field name="name"/>
                <field name="login"/>
                <field name="callcenter_primary_campaign_id"/>
                <field name="callcenter_supervised_campaign_ids"
                       widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_callcenter_agent_directory_form" model="ir.ui.view">
        <field name="name">res.users.callcenter.directory.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Call Center Person"
                  create="false"
                  delete="false"
                  edit="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="login"/>
                        <field name="callcenter_primary_campaign_id"/>
                        <field name="callcenter_supervised_campaign_ids"
                               widget="many2many_tags"/>
                    </group>
                    <group string="Assignment History">
                        <field name="callcenter_assignment_ids" readonly="1">
                            <list create="false" delete="false" edit="false">
                                <field name="campaign_id"/>
                                <field name="role"/>
                                <field name="is_primary"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="active"/>
                                <field name="assigned_by_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_callcenter_agent_directory" model="ir.actions.act_window">
        <field name="name">Agents &amp; Supervisors</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('callcenter_primary_campaign_id', '!=', False), ('callcenter_assignment_ids', '!=', False)]</field>
    </record>

    <record id="action_callcenter_agent_directory_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_callcenter_agent_directory_list"/>
        <field name="act_window_id" ref="action_callcenter_agent_directory"/>
    </record>

    <record id="action_callcenter_agent_directory_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_callcenter_agent_directory_form"/>
        <field name="act_window_id" ref="action_callcenter_agent_directory"/>
    </record>
</odoo>
