<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_callcenter" model="ir.ui.view">
        <field name="name">crm.team.form.callcenter</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='left']/field[@name='user_id']" position="after">
                <field name="is_callcenter_campaign" groups="callcenter.group_callcenter_superuser"/>
                <field name="campaign_code"
                       invisible="not is_callcenter_campaign"
                       required="is_callcenter_campaign"
                       groups="callcenter.group_callcenter_superuser"/>
                <field name="campaign_status"
                       invisible="not is_callcenter_campaign"
                       groups="callcenter.group_callcenter_superuser"/>
                <field name="primary_supervisor_id"
                       widget="many2one_avatar_user"
                       invisible="not is_callcenter_campaign"
                       groups="callcenter.group_callcenter_superuser"/>
                <field name="backup_supervisor_ids"
                       widget="many2many_tags_avatar"
                       invisible="not is_callcenter_campaign"
                       groups="callcenter.group_callcenter_superuser"/>
                <field name="campaign_start_date"
                       invisible="not is_callcenter_campaign"
                       groups="callcenter.group_callcenter_superuser"/>
                <field name="campaign_end_date"
                       invisible="not is_callcenter_campaign"
                       groups="callcenter.group_callcenter_superuser"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Call Center Assignment History"
                      name="callcenter_assignment_history"
                      invisible="not is_callcenter_campaign"
                      groups="callcenter.group_callcenter_supervisor,callcenter.group_callcenter_superuser">
                    <field name="callcenter_assignment_ids" readonly="1">
                        <list create="false" delete="false" edit="false">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="role"/>
                            <field name="is_primary"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                            <field name="assigned_by_id" widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_team_view_list_callcenter" model="ir.ui.view">
        <field name="name">crm.team.list.callcenter</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_tree"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_callcenter_campaign" optional="show"/>
                <field name="campaign_code" optional="show"/>
                <field name="campaign_status" optional="show"/>
                <field name="primary_supervisor_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
