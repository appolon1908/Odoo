<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_lead_ingestion" model="ir.module.category">
    <field name="name">Lead Ingestion</field><field name="sequence">35</field>
  </record>
  <record id="privilege_lead_ingestion" model="res.groups.privilege">
    <field name="name">Lead Ingestion</field><field name="sequence">35</field>
    <field name="category_id" ref="module_category_lead_ingestion"/>
  </record>
  <record id="group_lead_importer" model="res.groups">
    <field name="name">Lead Importer</field><field name="privilege_id" ref="privilege_lead_ingestion"/><field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
  </record>
  <record id="group_lead_reviewer" model="res.groups">
    <field name="name">Lead Reviewer</field><field name="privilege_id" ref="privilege_lead_ingestion"/><field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('group_lead_importer'))]"/>
  </record>
  <record id="group_compliance_manager" model="res.groups">
    <field name="name">Compliance Manager</field><field name="privilege_id" ref="privilege_lead_ingestion"/><field name="sequence">30</field>
    <field name="implied_ids" eval="[(4, ref('group_lead_reviewer')), (4, ref('call_center_core.group_call_center_compliance'))]"/>
  </record>
  <record id="group_lead_import_admin" model="res.groups">
    <field name="name">Lead Import Administrator</field><field name="privilege_id" ref="privilege_lead_ingestion"/><field name="sequence">40</field>
    <field name="implied_ids" eval="[(4, ref('group_compliance_manager'))]"/>
  </record>
  <record id="group_middleware_service" model="res.groups">
    <field name="name">Middleware Service</field><field name="privilege_id" ref="privilege_lead_ingestion"/><field name="sequence">50</field>
  </record>
  <record id="codestra_cc_security.group_cc_global_administrator" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_lead_import_admin'))]"/>
  </record>
</odoo>
