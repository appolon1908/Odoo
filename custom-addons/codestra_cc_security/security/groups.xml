<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_codestra_contact_center" model="ir.module.category">
    <field name="name">Codestra Contact Center</field>
    <field name="sequence">36</field>
  </record>

  <record id="privilege_codestra_contact_center" model="res.groups.privilege">
    <field name="name">Codestra Contact Center</field>
    <field name="sequence">36</field>
    <field name="category_id" ref="module_category_codestra_contact_center"/>
  </record>

  <record id="group_cc_scoped_user" model="res.groups">
    <field name="name">Campaign-Scoped Contact Center User</field>
    <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
  </record>

  <record id="group_cc_campaign_agent" model="res.groups">
    <field name="name">Campaign Agent</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
  </record>
  <record id="group_cc_senior_agent" model="res.groups">
    <field name="name">Senior Agent / SME</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_campaign_agent')])]"/>
  </record>
  <record id="group_cc_campaign_supervisor" model="res.groups">
    <field name="name">Campaign Supervisor</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">30</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_senior_agent')])]"/>
  </record>
  <record id="group_cc_quality_analyst" model="res.groups">
    <field name="name">Quality Assurance Analyst</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">40</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
  </record>
  <record id="group_cc_workforce_analyst" model="res.groups">
    <field name="name">Workforce / Real-Time Analyst</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">50</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
  </record>
  <record id="group_cc_compliance_officer" model="res.groups">
    <field name="name">Compliance Officer</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">60</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
  </record>
  <record id="group_cc_campaign_configuration_manager" model="res.groups">
    <field name="name">Campaign Configuration Manager</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">70</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
  </record>
  <record id="group_cc_auditor" model="res.groups">
    <field name="name">Contact Center Auditor</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">80</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
  </record>
  <record id="group_cc_global_administrator" model="res.groups">
    <field name="name">Global Contact Center Administrator</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">90</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_scoped_user')])]"/>
    <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>
  <record id="group_cc_call_center_superuser" model="res.groups">
    <field name="name">Call Center Super User</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">95</field>
    <field name="implied_ids" eval="[(6, 0, [ref('group_cc_global_administrator')])]"/>
  </record>
  <record id="group_cc_technical_administrator" model="res.groups">
    <field name="name">Technical Administrator</field>
    <field name="privilege_id" ref="privilege_codestra_contact_center"/>
    <field name="sequence">100</field>
    <field name="implied_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
  </record>

  <record id="call_center_core.menu_call_center_configuration" model="ir.ui.menu">
    <field name="group_ids" eval="[(4, ref('group_cc_global_administrator')), (4, ref('group_cc_auditor'))]"/>
  </record>
</odoo>
